#!/usr/bin/python3

import http.client
import ipaddress
import json
import re
import shutil
import ssl
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

SECRET_LABEL = "Karakeep API token (embiem.karakeep)"
SECRET_ATTRIBUTES = [
    "application",
    "org.omarchy.shell.plugin",
    "plugin",
    "embiem.karakeep",
    "service",
    "karakeep",
]
MAX_RESPONSE_BYTES = 1024 * 1024
VALIDATE_TIMEOUT_SECONDS = 10
ADD_TIMEOUT_SECONDS = 20

# Karakeep answers 403 with a plain-text body naming the one scope it wanted:
# `API key is missing required scope: users:read`
# (packages/api/middlewares/apiKeyScopes.ts).
MISSING_SCOPE = re.compile(
    r"missing required scope: ((?:admin:)?[a-zA-Z]{1,24}:read(?:write)?)\b"
)


def emit(payload):
    sys.stdout.write(json.dumps(payload, separators=(",", ":")))
    sys.stdout.write("\n")


def secret_tool_path():
    return shutil.which("secret-tool")


def canonical_server_url(value):
    text = value.strip() if isinstance(value, str) else ""
    if text == "":
        raise ValueError("Enter your Karakeep server address.")
    if any(
        character.isspace() or ord(character) < 32 or ord(character) == 127
        for character in text
    ):
        raise ValueError("Enter a valid Karakeep server address.")

    candidate = text if "://" in text else "https://" + text
    try:
        parts = urllib.parse.urlsplit(candidate)
        port = parts.port
    except ValueError:
        raise ValueError("Enter a valid Karakeep server address.")
    # urlsplit rejects an out-of-range port but accepts 0, which no server listens on.
    if port == 0:
        raise ValueError("Enter a valid Karakeep server address.")

    scheme = parts.scheme.lower()
    if scheme not in ("https", "http"):
        raise ValueError("Enter a valid Karakeep server address.")
    if parts.username is not None or parts.password is not None:
        raise ValueError("Enter a valid Karakeep server address.")
    if parts.query or parts.fragment:
        raise ValueError("Enter a valid Karakeep server address.")
    if parts.path not in ("", "/", "/api/v1", "/api/v1/"):
        raise ValueError("Enter a valid Karakeep server address.")

    hostname = parts.hostname
    if not hostname:
        raise ValueError("Enter a valid Karakeep server address.")
    hostname = hostname.lower()

    if scheme == "http" and hostname != "localhost":
        try:
            if not ipaddress.ip_address(hostname).is_loopback:
                raise ValueError
        except ValueError:
            raise ValueError(
                "Karakeep API keys require HTTPS. Configure TLS on the self-hosted server."
            )

    host = "[{}]".format(hostname) if ":" in hostname else hostname
    default_port = 443 if scheme == "https" else 80
    port_suffix = "" if port is None or port == default_port else ":{}".format(port)
    return "{}://{}{}".format(scheme, host, port_suffix)


def valid_api_key(value):
    if not isinstance(value, str) or value == "":
        raise ValueError("Enter a valid Karakeep API key.")
    # Printable ASCII only: a space or control character could smuggle a second
    # header, and anything outside latin-1 makes http.client.putheader raise a
    # UnicodeEncodeError whose raw codec message would become the user's error.
    if any(ord(character) < 33 or ord(character) > 126 for character in value):
        raise ValueError("Enter a valid Karakeep API key.")
    return value


def load_connection():
    secret_tool = secret_tool_path()
    if secret_tool is None:
        return None

    try:
        result = subprocess.run(
            [secret_tool, "lookup", *SECRET_ATTRIBUTES],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=15,
        )
    # text=True decodes in the process locale, so a keyring item holding
    # arbitrary bytes must fail closed here instead of raising past the caller.
    except (OSError, UnicodeDecodeError, subprocess.TimeoutExpired):
        return None

    if result.returncode != 0:
        return None

    try:
        parsed = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None

    if (
        not isinstance(parsed, dict)
        or len(parsed) != 2
        or set(parsed.keys()) != {"serverUrl", "apiKey"}
    ):
        return None
    if not isinstance(parsed.get("serverUrl"), str) or not isinstance(
        parsed.get("apiKey"), str
    ):
        return None

    # Imported or stale keyring data must fail closed before any request uses it.
    try:
        return {
            "serverUrl": canonical_server_url(parsed["serverUrl"]),
            "apiKey": valid_api_key(parsed["apiKey"]),
        }
    except ValueError:
        return None


def store_connection(server_url, api_key):
    secret_tool = secret_tool_path()
    if secret_tool is None:
        return False

    payload = json.dumps(
        {"serverUrl": server_url, "apiKey": api_key}, separators=(",", ":")
    )
    try:
        result = subprocess.run(
            [secret_tool, "store", f"--label={SECRET_LABEL}", *SECRET_ATTRIBUTES],
            input=payload,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False

    return result.returncode == 0


def clear_connection():
    secret_tool = secret_tool_path()
    if secret_tool is None:
        return False

    try:
        result = subprocess.run(
            [secret_tool, "clear", *SECRET_ATTRIBUTES],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False

    return result.returncode == 0


class NoRedirect(urllib.request.HTTPRedirectHandler):
    # urllib's default redirect handler forwards Authorization to the new target.
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


# ProxyHandler({}) opts out of http_proxy/HTTPS_PROXY. On Linux proxy_bypass
# only consults no_proxy, so a loopback origin allowed for local development
# would otherwise hand Authorization to a configured proxy in cleartext.
opener = urllib.request.build_opener(
    urllib.request.ProxyHandler({}),
    urllib.request.HTTPSHandler(context=ssl.create_default_context()),
    NoRedirect(),
)


def request_json(method, server_url, api_key, path, payload, timeout):
    headers = {
        "Authorization": "Bearer " + api_key,
        "Accept": "application/json",
    }
    data = None
    if payload is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(payload, separators=(",", ":")).encode("utf-8")

    request = urllib.request.Request(
        server_url + "/api/v1" + path,
        data=data,
        headers=headers,
        method=method,
    )

    try:
        with opener.open(request, timeout=timeout) as response:
            body = response.read(MAX_RESPONSE_BYTES + 1)
            if len(body) > MAX_RESPONSE_BYTES:
                raise ValueError("Karakeep returned too much data.")
            return response.getcode(), body
    except urllib.error.HTTPError as error:
        body = error.read(MAX_RESPONSE_BYTES + 1)
        if len(body) > MAX_RESPONSE_BYTES:
            raise ValueError("Karakeep returned too much data.")
        if 300 <= error.code < 400:
            raise ValueError(
                "Karakeep redirected the API request. Use the final HTTPS server address."
            )
        return error.code, body
    except urllib.error.URLError as error:
        # Returned messages stay fixed so server text, TLS internals, and tokens never leak.
        if isinstance(error.reason, ssl.SSLCertVerificationError):
            raise ValueError("TLS verification failed for {}.".format(server_url))
        raise ValueError("Could not securely reach {}.".format(server_url))
    except (OSError, http.client.HTTPException):
        # A fault while reading the body raises past both handlers above
        # (TimeoutError is an OSError, not a URLError), which would end the
        # process with a traceback and no result object.
        raise ValueError("Could not securely reach {}.".format(server_url))


def parse_json_object(body):
    try:
        parsed = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None
    return parsed if isinstance(parsed, dict) else None


def missing_scope(body):
    # Only the scope-shaped match is returned, so the rest of a
    # server-controlled 403 body still never reaches the UI.
    try:
        text = body.decode("utf-8")
    except UnicodeDecodeError:
        return None
    match = MISSING_SCOPE.search(text[:512])
    return match.group(1) if match else None


def read_json_line():
    # For `login` the line being decoded is the credential itself, so a decode
    # failure must not surface as a traceback.
    try:
        return json.loads(sys.stdin.readline())
    except (UnicodeDecodeError, ValueError):
        return None


def credential_unavailable():
    return {
        "ok": False,
        "error": "Credential unavailable. Unlock Secret Service or reconnect.",
    }


def action_status():
    connection = load_connection()
    if connection is None:
        emit(credential_unavailable())
        return 0

    emit({"ok": True, "configured": True, "serverUrl": connection["serverUrl"]})
    return 0


def action_login():
    payload = read_json_line()
    if not isinstance(payload, dict) or not isinstance(payload.get("serverUrl"), str):
        emit({"ok": False, "error": "Enter your Karakeep server address."})
        return 0
    if not isinstance(payload.get("apiKey"), str):
        emit({"ok": False, "error": "Enter a valid Karakeep API key."})
        return 0

    try:
        server_url = canonical_server_url(payload["serverUrl"])
        api_key = valid_api_key(payload["apiKey"])
        status, body = request_json(
            "GET",
            server_url,
            api_key,
            "/users/me",
            None,
            VALIDATE_TIMEOUT_SECONDS,
        )
    except ValueError as error:
        emit({"ok": False, "error": str(error)})
        return 0

    if status == 200:
        if parse_json_object(body) is None:
            emit({"ok": False, "error": "Karakeep answered HTTP 200."})
            return 0
        if not store_connection(server_url, api_key):
            emit(
                {
                    "ok": False,
                    "error": "Could not store the API key. Unlock Secret Service and try again.",
                }
            )
            return 0
        emit({"ok": True, "configured": True, "serverUrl": server_url})
        return 0

    if status in (401, 403):
        scope = missing_scope(body) if status == 403 else None
        if scope is not None:
            emit(
                {
                    "ok": False,
                    "error": "That API key is missing the {} scope. Add it in Karakeep under Settings > API Keys.".format(
                        scope
                    ),
                }
            )
            return 0
        emit({"ok": False, "error": "Karakeep rejected that API key."})
        return 0
    if status == 404:
        emit({"ok": False, "error": "No Karakeep API at {}/api/v1.".format(server_url)})
        return 0

    emit({"ok": False, "error": "Karakeep answered HTTP {}.".format(status)})
    return 0


def action_add():
    connection = load_connection()
    if connection is None:
        emit(credential_unavailable())
        return 0

    payload = read_json_line()
    if (
        isinstance(payload, dict)
        and set(payload.keys()) == {"type", "url"}
        and payload.get("type") == "link"
        and isinstance(payload.get("url"), str)
        and payload["url"] != ""
    ):
        bookmark = {"type": "link", "url": payload["url"]}
    elif (
        isinstance(payload, dict)
        and set(payload.keys()) == {"type", "text"}
        and payload.get("type") == "text"
        and isinstance(payload.get("text"), str)
        and payload["text"] != ""
    ):
        bookmark = {"type": "text", "text": payload["text"]}
    else:
        emit({"ok": False, "error": "Karakeep rejected that entry."})
        return 0

    try:
        status, body = request_json(
            "POST",
            connection["serverUrl"],
            connection["apiKey"],
            "/bookmarks",
            bookmark,
            ADD_TIMEOUT_SECONDS,
        )
    except ValueError as error:
        emit({"ok": False, "error": str(error)})
        return 0

    if status in (200, 201):
        parsed = parse_json_object(body)
        bookmark_id = parsed.get("id") if isinstance(parsed, dict) else None
        if not isinstance(bookmark_id, str) or bookmark_id == "":
            emit({"ok": False, "error": "Karakeep saved the entry but returned no id."})
            return 0
        emit({"ok": True, "id": bookmark_id, "existing": status == 200})
        return 0

    if status in (400, 422):
        emit({"ok": False, "error": "Karakeep rejected that entry."})
        return 0
    if status in (401, 403):
        scope = missing_scope(body) if status == 403 else None
        if scope is not None:
            emit(
                {
                    "ok": False,
                    "error": "The stored API key is missing the {} scope. Add it in Karakeep, then reconnect.".format(
                        scope
                    ),
                }
            )
            return 0
        emit(
            {
                "ok": False,
                "error": "Karakeep rejected the stored API key. Reconnect to update it.",
            }
        )
        return 0

    emit({"ok": False, "error": "Karakeep answered HTTP {}.".format(status)})
    return 0


def action_clear():
    if clear_connection():
        emit({"ok": True, "configured": False})
        return 0

    emit(
        {
            "ok": False,
            "error": "Could not remove the API key. Unlock Secret Service and try again.",
        }
    )
    return 0


def main(argv):
    if len(argv) != 2:
        return 2

    action = argv[1]
    if action == "status":
        return action_status()
    if action == "login":
        return action_login()
    if action == "add":
        return action_add()
    if action == "clear":
        return action_clear()
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
